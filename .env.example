# CyberRange Environment Configuration Template
# Duplicate this file to .env and configure values

ENVIRONMENT=development
DEBUG=true

# Security / Authentication
JWT_SECRET=cyberrange-super-secret-production-key-change-in-prod-128bits!
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# Database Configuration (PostgreSQL in container / SQLite async fallback for standalone dev)
DATABASE_URL=sqlite+aiosqlite:///./cyberrange.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:cyberrangepass@localhost:5432/cyberrange

# Redis Configuration (Optional in development, uses in-memory fallbacks when unavailable)
REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# File Upload & Evidence Settings
UPLOAD_MAX_MB=25
EVIDENCE_STORAGE_PATH=./data/evidence

# Engine Configuration
DETECTION_RULES_PATH=./detection-rules
SCENARIOS_PATH=./data/attack-scenarios
IOC_DB_PATH=./data/sample-iocs/ioc_reputation_db.json
